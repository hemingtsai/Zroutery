{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hemingtsai/Zroutery/docs/development/state.schema.json",
  "title": "Zroutery current state",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "head",
    "branch",
    "gates",
    "blockers",
    "flaky",
    "last_full_green"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Schema generation; must be 1."
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date this state snapshot was produced."
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Latest commit that changed code, not the latest docs commit."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Git branch this snapshot belongs to."
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Gate name."
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified",
              "unrun",
              "retired"
            ],
            "description": "pass/fail/unverified/unrun/retired."
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Command used for this snapshot."
          },
          "detail": {
            "type": "string",
            "description": "Short result detail."
          },
          "quarantine": {
            "type": "object",
            "required": [
              "owner",
              "review_by",
              "reason"
            ],
            "additionalProperties": false,
            "description": "Owner, reason and review deadline for a quarantined gate.",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "review_by": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "ran_at": {
            "type": "string",
            "description": "When the command last ran."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$",
            "description": "Code commit the command ran against."
          }
        },
        "additionalProperties": false
      },
      "description": "Verification gates and their last recorded status."
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-Za-z-]+$",
            "description": "Stable blocker id."
          },
          "status": {
            "enum": [
              "partial",
              "blocked",
              "ready",
              "done",
              "open"
            ],
            "description": "Blocker lifecycle state."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "One-line blocker summary."
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Blocker ids that must close first."
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Person or role responsible."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Document or ADR that owns the blocker."
          },
          "review_by": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Date to review the blocker."
          }
        },
        "additionalProperties": false
      },
      "description": "Durable blockers; ids are stable labels, not issue links."
    },
    "flaky": {
      "type": "array",
      "description": "Known flaky gates with owner and review deadline.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "reason",
          "owner",
          "review_by"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "review_by": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "last_full_green": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date of the last complete Tier-green snapshot, or null."
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
