# Rust
/target
**/target

# Frontend
node_modules
ui/dist

# Tauri codegen
src-tauri/gen

# Generated by `tauri-build` from the app manifest in `src-tauri/build.rs`. The
# command list in that file is the source of truth and the files are rewritten
# on every build.
src-tauri/permissions/autogenerated/

# macOS
.DS_Store

# Local overrides
.env

# ML runtime state: durable routing traces and the active-model pointer.
# These are written by a running proxy and are data, not source. A relative
# `ml_routing.state_dir` resolves against the process working directory, which
# for a dev run is the crate root.
/ml/
**/ml/traces.jsonl
**/ml/active-model.json
**/ml/active-model-audit.jsonl
**/ml/*.json.tmp

# IDE
.zcode/
.vscode/
.idea/
.cursor/

# Coverage and profiler output. Both are per-run artefacts that a gate can
# leave behind, and neither is source: a dirty tree after `cargo llvm-cov` or a
# profiling session trains people to ignore `git status`.
lcov.info
coverage/
*.profraw
*.log

# The frontend size table. CI writes it and uploads it as an artifact; a local
# run of the same step leaves one behind.
dist-size.txt

# Python bytecode. The gates are Python scripts, and one that imports another
# leaves a __pycache__ behind; the tree should not be dirty for having run them.
__pycache__/
*.pyc

# Local screenshots written by the browser tooling.
.openchamber/
